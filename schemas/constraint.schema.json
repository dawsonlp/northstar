{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripartite.dev/schemas/northstar/constraint.json",
  "title": "NorthstarConstraint",
  "description": "Schema for Invariant Constraints and Guardrails in Northstar",
  "type": "object",
  "required": ["uri", "title", "status", "type", "provenance"],
  "properties": {
    "uri": {
      "type": "string",
      "pattern": "^constraint://[a-z0-9_/-]+/[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "ACTIVE", "DEPRECATED", "SUPERSEDED"],
      "default": "ACTIVE"
    },
    "type": {
      "type": "string",
      "enum": ["ARCHITECTURAL_BOUNDARY", "DECORATOR_INVARIANT", "PURITY", "TYPE_CONTRACT", "CUSTOM_CALLABLE"]
    },
    "governing_adr": {
      "type": "string",
      "pattern": "^decision://"
    },
    "remediation_hint": {
      "type": "string"
    },
    "executable_rule": {
      "type": "object",
      "properties": {
        "engine": { "type": "string", "enum": ["python_callable", "ast_layer_check", "rego"] },
        "expression": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["tier", "confidence"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["DECLARED", "DERIVED", "INFERRED"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  },
  "additionalProperties": false
}

