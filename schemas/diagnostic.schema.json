{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripartite.dev/schemas/northstar/diagnostic.json",
  "title": "NorthstarConstraintViolation",
  "description": "Schema for structured invariant constraint violations and actionable remediation hints",
  "type": "object",
  "required": ["constraint_uri", "severity", "violation_target", "message", "remediation_hint"],
  "properties": {
    "constraint_uri": {
      "type": "string",
      "pattern": "^constraint://"
    },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "ERROR", "BLOCKER"]
    },
    "violation_target": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "governing_adr": {
      "type": "string",
      "pattern": "^decision://"
    },
    "remediation_hint": {
      "type": "string"
    },
    "location": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer" },
        "symbol": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}

