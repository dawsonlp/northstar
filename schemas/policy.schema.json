{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripartite.dev/schemas/northstar/policy.json",
  "title": "NorthstarPolicy",
  "description": "Schema for Compliance, Security, and Governance Policies in Northstar",
  "type": "object",
  "required": ["uri", "title", "domain", "status", "provenance"],
  "properties": {
    "uri": {
      "type": "string",
      "pattern": "^policy://[a-z0-9_/-]+/[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "ACTIVE", "DEPRECATED", "SUPERSEDED"],
      "default": "ACTIVE"
    },
    "compliance_framework": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": ["tier", "confidence"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["DECLARED", "DERIVED", "INFERRED"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  },
  "additionalProperties": false
}

