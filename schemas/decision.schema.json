{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tripartite.dev/schemas/northstar/decision.json",
  "title": "NorthstarArchitecturalDecision",
  "description": "Schema for Architectural Decision Records (ADRs) in Northstar",
  "type": "object",
  "required": ["uri", "title", "status", "context", "decision", "provenance"],
  "properties": {
    "uri": {
      "type": "string",
      "pattern": "^decision://[a-z0-9_/-]+/adr-[0-9]+-[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "PROPOSED", "ACTIVE", "DEPRECATED", "SUPERSEDED"],
      "default": "DRAFT"
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "consequences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "alternatives_considered": {
      "type": "array",
      "items": { "type": "string" }
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^decision://"
    },
    "provenance": {
      "type": "object",
      "required": ["tier", "confidence"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["DECLARED", "DERIVED", "INFERRED"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "author": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

